<!-- FIXIT VOICE: Seccion independiente (precios generados desde voice-plans.js) -->
<section class="sp voice" id="voice" style="border-top:1px solid rgba(42,48,64,0.3);border-bottom:1px solid rgba(42,48,64,0.3);position:relative;">
  <div class="w">
    <div class="voice-hero">
      <div>
        <span class="eyebrow">Para negocios que no pueden perder llamadas</span>
        <h2 class="voice-title">Contesta cada llamada. <span>Aunque no estés tú.</span></h2>
        <p class="voice-sub">Un agente de voz con inteligencia artificial que atiende tu negocio las 24 horas, toma pedidos, agenda citas y nunca deja a un cliente esperando en la línea.</p>
        <div class="hero-btns">
          <a href="https://wa.me/526861959581?text=Hola%2C%20quiero%20una%20demo%20de%20FixIT%20Voice" target="_blank" class="btn btn-wa js-voice-demo">
            <i class="fa-brands fa-whatsapp"></i> Quiero una demo gratis
          </a>
          <a href="#voice-precios" class="btn btn-o">
            <i class="fa-solid fa-arrow-down"></i> Ver precios
          </a>
        </div>
      </div>
      <div>
        <div class="call-mockup">
          <div class="call-head">
            <div class="call-avatar"><i class="fa-solid fa-phone"></i></div>
            <div>
              <div class="call-name">FixIT Voice</div>
              <div class="call-status"><span class="live-dot"></span> En llamada</div>
            </div>
            <div class="call-timer">00:12</div>
          </div>
          <div class="call-body">
            <div class="msg client">
              <span class="msg-label">Cliente</span>
              ¿Tienen servicio de entrega a domicilio hoy?
            </div>
            <div class="msg agent">
              <span class="msg-label">FixIT Voice &middot; IA</span>
              Sí, claro. ¿Me confirmas tu dirección para calcular el tiempo de entrega?
            </div>
          </div>
          <div class="call-foot">
            <div class="wave"><span></span><span></span><span></span><span></span><span></span></div>
            <div class="call-foot-text">Respondiendo en tiempo real</div>
          </div>
        </div>
      </div>
    </div>

    <div class="voice-block">
      <div class="voice-eb"><span class="eyebrow">Características</span></div>
      <h3 class="voice-h">Todo lo que hace por tu negocio</h3>
      <p class="voice-s">No es un contestador. Es un agente que entiende, responde y registra cada llamada.</p>
      <div class="voice-feat-grid">
        <div class="voice-feat-card">
          <div class="voice-feat-icon blue"><i class="fa-solid fa-clock"></i></div>
          <h3>Disponible siempre</h3>
          <p>Contesta a cualquier hora, incluso de madrugada o en día festivo.</p>
        </div>
        <div class="voice-feat-card">
          <div class="voice-feat-icon orange"><i class="fa-solid fa-clipboard-check"></i></div>
          <h3>Toma pedidos y citas</h3>
