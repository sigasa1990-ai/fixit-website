          <i class="fa-solid fa-paper-plane"></i> Activar prueba gratis
        </button>
        <div class="reg-msg" id="regMsg"></div>
        <p style="margin-top:12px;font-size:0.8rem;color:var(--muted);text-align:center;">Al registrarte aceptas nuestro <a href="terminos.html" style="color:var(--green);">Aviso de Privacidad</a>.</p>
      </div>
    </div>
