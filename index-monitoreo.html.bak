<script src="voice-plans.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var hdr = document.getElementById('hdr');
  var ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(function() { hdr.classList.toggle('scrolled', window.scrollY > 50); ticking = false; });
      ticking = true;
    }
  });

  var mb = document.getElementById('menuBtn'), nm = document.getElementById('navMenu');
  mb.addEventListener('click', function() {
    nm.classList.toggle('open');
    mb.querySelector('i').className = nm.classList.contains('open') ? 'fa-solid fa-times' : 'fa-solid fa-bars';
  });
  nm.querySelectorAll('a:not(.btn)').forEach(function(l) {
    l.addEventListener('click', function() { nm.classList.remove('open'); mb.querySelector('i').className = 'fa-solid fa-bars'; });
  });
  document.addEventListener('click', function(e) {
    if (nm.classList.contains('open') && !nm.contains(e.target) && !mb.contains(e.target)) {
      nm.classList.remove('open'); mb.querySelector('i').className = 'fa-solid fa-bars';
    }
  });

  if (!localStorage.getItem('cookiesAccepted')) document.getElementById('cookieBanner').classList.add('show');
  document.getElementById('cookieAccept').addEventListener('click', function() {
    localStorage.setItem('cookiesAccepted', 'true');
    document.getElementById('cookieBanner').classList.remove('show');
  });

  /* ===== FixIT Voice: precios y enlaces generados desde voice-plans.js ===== */
  var voiceCfg = window.FIXIT_VOICE;
  if (voiceCfg) {
    var vfmt = function(n) { return n.toLocaleString('es-MX'); };
    var vWaBase = 'https://wa.me/' + voiceCfg.whatsappNumber;
    var vDemoUrl = vWaBase + '?text=' + encodeURIComponent(voiceCfg.whatsappMessage);
    document.querySelectorAll('.js-voice-demo').forEach(function(el) { el.href = vDemoUrl; });

    var vGrid = document.getElementById('voicePlansGrid');
    if (vGrid) {
      voiceCfg.plans.forEach(function(plan) {
        var card = document.createElement('div');
        card.className = 'voice-plan-card' + (plan.popular ? ' popular' : '');

        if (plan.popular) {
          var badge = document.createElement('div');
          badge.className = 'popular-badge';
          badge.textContent = 'MÁS POPULAR';
          card.appendChild(badge);
        }

        var name = document.createElement('div');
        name.className = 'plan-name';
        name.textContent = plan.name;
        card.appendChild(name);

        var mins = document.createElement('div');
        mins.className = 'plan-minutes';
        mins.textContent = vfmt(plan.minutes) + ' min/mes incluidos';
        card.appendChild(mins);

        var price = document.createElement('div');
        price.className = 'plan-price';
        price.textContent = '$' + vfmt(plan.price) + ' ';
        var cur = document.createElement('span');
        cur.textContent = voiceCfg.currency + '/mes';
        price.appendChild(cur);
        card.appendChild(price);

        var feats = document.createElement('div');
        feats.className = 'plan-features';
        plan.features.forEach(function(f) {
          var d = document.createElement('div');
          d.textContent = '✓ ' + f;
          feats.appendChild(d);
        });
        card.appendChild(feats);

        var cta = document.createElement('a');
        cta.className = 'plan-cta' + (plan.popular ? ' filled' : '');
        cta.target = '_blank';
        cta.href = vWaBase + '?text=' + encodeURIComponent(
          'Hola, quiero una demo de FixIT Voice — plan ' + plan.name + ' (' + vfmt(plan.minutes) + ' min/mes)'
        );
        cta.textContent = 'Agendar demo';
        card.appendChild(cta);

        vGrid.appendChild(card);
      });
    }

    var vNote = document.getElementById('voiceSetupNote');
    if (vNote) {
      vNote.textContent = '+ $' + vfmt(voiceCfg.setupFee) + ' ' + voiceCfg.currency + ' de implementación inicial (pago único).';
    }
  }
});

let selectedPlanId = null;

function openCheckout(planId, name, price, storage) {
  selectedPlanId = planId;
  document.getElementById('modalPlanName').textContent = 'FixIT Backup - ' + name;
  document.getElementById('modalPlanDetail').textContent = price + ' MXN/mes — ' + storage;
  document.getElementById('checkoutError').style.display = 'none';
  document.getElementById('checkoutName').value = '';
  document.getElementById('checkoutEmail').value = '';
  document.getElementById('checkoutCompany').value = '';
  document.getElementById('checkoutRfc').value = '';
  document.getElementById('checkoutBtn').disabled = false;
  document.getElementById('checkoutBtn').textContent = 'Ir a pagar';
  document.getElementById('checkoutModalBg').style.display = 'block';
  document.getElementById('checkoutModal').style.display = 'block';
}

function closeCheckoutModal() {
  document.getElementById('checkoutModalBg').style.display = 'none';
  document.getElementById('checkoutModal').style.display = 'none';
}

function startCheckout() {
  const email = document.getElementById('checkoutEmail').value.trim();
  const name = document.getElementById('checkoutName').value.trim();
  const company = document.getElementById('checkoutCompany').value.trim();
  const rfc = document.getElementById('checkoutRfc').value.trim().toUpperCase();
  const errEl = document.getElementById('checkoutError');

  if (!email) { errEl.textContent = 'Ingresa tu correo electrónico'; errEl.style.display = 'block'; return; }
  if (!email.includes('@')) { errEl.textContent = 'Correo inválido'; errEl.style.display = 'block'; return; }
  if (!name) { errEl.textContent = 'Ingresa tu nombre'; errEl.style.display = 'block'; return; }

  const btn = document.getElementById('checkoutBtn');
  btn.disabled = true;
  btn.textContent = 'Redirigiendo a Stripe...';
  errEl.style.display = 'none';

  var apiUrl;
  if (window.location.hostname === 'fixitsoluciones.com' || window.location.hostname === 'www.fixitsoluciones.com') {
    apiUrl = 'https://rmm.fixitsoluciones.com/api/public/backup-checkout';
  } else {
    apiUrl = '/api/public/backup-checkout';
  }

  fetch(apiUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ planId: selectedPlanId, email: email, name: name, company: company, rfc: rfc || undefined }),
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.url) {
      window.location.href = data.url;
    } else {
      errEl.textContent = data.error || 'Error al crear el pago';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Ir a pagar';
    }
  })
  .catch(function() {
    errEl.textContent = 'Error de conexión. Intenta de nuevo.';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Ir a pagar';
  });
}

function handleRegister() {
  const btn = document.getElementById('regBtn');
  const msg = document.getElementById('regMsg');
  const name = document.getElementById('regName').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const empresa = document.getElementById('regEmpresa').value.trim();
  const phone = document.getElementById('regPhone').value.trim();

  if (!name || !email || !empresa || !phone) {
    msg.className = 'reg-msg error';
    msg.textContent = 'Por favor completa todos los campos incluyendo WhatsApp (lo necesitamos para activarte).';
    return;
  }

  if (!email.includes('@') || !email.includes('.')) {
    msg.className = 'reg-msg error';
    msg.textContent = 'Por favor ingresa un correo electrónico válido.';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registrando...';
  msg.className = 'reg-msg loading';
  msg.textContent = 'Procesando tu registro...';

  var apiUrl;
  if (window.location.hostname === 'fixitsoluciones.com' || window.location.hostname === 'www.fixitsoluciones.com') {
    apiUrl = 'https://rmm.fixitsoluciones.com/api/public/register';
  } else {
    apiUrl = '/api/public/register';
  }

  fetch(apiUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ nombre: empresa, email: email, contactName: name, phone: phone || undefined }),
  })
  .then(function(r) { return r.json().then(function(d) { return { status: r.status, data: d }; }); })
  .then(function(res) {
    if (res.status === 201) {
      msg.className = 'reg-msg success';
      msg.innerHTML = '<i class="fa-solid fa-check-circle"></i> ' + (res.data.message || 'Registro exitoso. Te contactaremos por WhatsApp para activar tu prueba.');
      document.getElementById('regName').value = '';
      document.getElementById('regEmail').value = '';
      document.getElementById('regEmpresa').value = '';
      document.getElementById('regPhone').value = '';
    } else {
      msg.className = 'reg-msg error';
      msg.textContent = res.data.error || 'Error al registrarse. Intenta de nuevo.';
    }
  })
  .catch(function(err) {
    msg.className = 'reg-msg error';
    msg.textContent = 'Error de conexión. Verifica tu internet e intenta de nuevo.';
  })
  .finally(function() {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Activar prueba gratis';
  });
}
</script>
</body>
</html>
