</footer>

<div class="wa-float">
  <a href="https://wa.me/526861959581?text=Hola%2C%20quiero%20una%20demo%20de%20FixIT%20Voice" target="_blank" class="js-voice-demo">
    <i class="fa-brands fa-whatsapp"></i> Agenda tu demo gratis
  </a>
</div>

<script src="voice-plans.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var hdr = document.getElementById('hdr');
  var ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(function() { hdr.classList.toggle('scrolled', window.scrollY > 50); ticking = false; });
      ticking = true;
    }
  });

  var mb = document.getElementById('menuBtn'), nm = document.getElementById('navMenu');
  mb.addEventListener('click', function() {
    nm.classList.toggle('open');
    mb.querySelector('i').className = nm.classList.contains('open') ? 'fa-solid fa-times' : 'fa-solid fa-bars';
  });
  nm.querySelectorAll('a:not(.btn)').forEach(function(l) {
    l.addEventListener('click', function() { nm.classList.remove('open'); mb.querySelector('i').className = 'fa-solid fa-bars'; });
  });
  document.addEventListener('click', function(e) {
    if (nm.classList.contains('open') && !nm.contains(e.target) && !mb.contains(e.target)) {
      nm.classList.remove('open'); mb.querySelector('i').className = 'fa-solid fa-bars';
    }
  });

  if (!localStorage.getItem('cookiesAccepted')) document.getElementById('cookieBanner').classList.add('show');
  document.getElementById('cookieAccept').addEventListener('click', function() {
    localStorage.setItem('cookiesAccepted', 'true');
    document.getElementById('cookieBanner').classList.remove('show');
  });

  /* ===== FixIT Voice: precios y enlaces generados desde voice-plans.js ===== */
  var voiceCfg = window.FIXIT_VOICE;
  if (voiceCfg) {
    var vfmt = function(n) { return n.toLocaleString('es-MX'); };
    var vWaBase = 'https://wa.me/' + voiceCfg.whatsappNumber;
    var vDemoUrl = vWaBase + '?text=' + encodeURIComponent(voiceCfg.whatsappMessage);
    document.querySelectorAll('.js-voice-demo').forEach(function(el) { el.href = vDemoUrl; });

    var vGrid = document.getElementById('voicePlansGrid');
    if (vGrid) {
      voiceCfg.plans.forEach(function(plan) {
        var card = document.createElement('div');
        card.className = 'voice-plan-card' + (plan.popular ? ' popular' : '');

        if (plan.popular) {
          var badge = document.createElement('div');
          badge.className = 'popular-badge';
          badge.textContent = 'MÁS POPULAR';
          card.appendChild(badge);
        }

        var name = document.createElement('div');
        name.className = 'plan-name';
        name.textContent = plan.name;
        card.appendChild(name);

        var mins = document.createElement('div');
        mins.className = 'plan-minutes';
        mins.textContent = vfmt(plan.minutes) + ' min/mes incluidos';
        card.appendChild(mins);

        var price = document.createElement('div');
        price.className = 'plan-price';
        price.textContent = '$' + vfmt(plan.price) + ' ';
        var cur = document.createElement('span');
        cur.textContent = voiceCfg.currency + '/mes';
        price.appendChild(cur);
        card.appendChild(price);

        var feats = document.createElement('div');
        feats.className = 'plan-features';
        plan.features.forEach(function(f) {
          var d = document.createElement('div');
          d.textContent = '✓ ' + f;
          feats.appendChild(d);
        });
        card.appendChild(feats);

        var cta = document.createElement('a');
        cta.className = 'plan-cta' + (plan.popular ? ' filled' : '');
        cta.target = '_blank';
        cta.href = vWaBase + '?text=' + encodeURIComponent(
          'Hola, quiero una demo de FixIT Voice — plan ' + plan.name + ' (' + vfmt(plan.minutes) + ' min/mes)'
        );
        cta.textContent = 'Agendar demo';
        card.appendChild(cta);

        vGrid.appendChild(card);
      });
    }

    var vNote = document.getElementById('voiceSetupNote');
    if (vNote) {
      vNote.textContent = '+ $' + vfmt(voiceCfg.setupFee) + ' ' + voiceCfg.currency + ' de implementación inicial (pago único).';
    }
  }
});

</script>
</body>
</html>
