      <a href="https://wa.me/526861959581?text=Hola%2C%20quiero%20una%20demo%20de%20FixIT%20Voice" target="_blank" class="btn btn-wa js-voice-demo" style="padding:8px 18px;font-size:0.85rem;color:#fff;">
        <i class="fa-brands fa-whatsapp"></i> Agendar demo
      </a>
    </nav>
  </div>
</header>

<!-- FIXIT VOICE: pagina principal (precios generados desde voice-plans.js) -->
<section class="sp voice" id="voice" style="position:relative;">
  <div class="w">
    <div class="voice-hero">
      <div>
        <span class="eyebrow">Para negocios que no pueden perder llamadas</span>
