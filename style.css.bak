.split-text, .benefits-content { text-align: left; }
.text-left::after { left: 0; transform: none; }

.split-image, .benefits-image-col { display: flex; justify-content: center; align-items: center; }
.split-image img, .benefits-image-col img { width: 100%; max-width: 550px; height: auto; border-radius: var(--radius-lg); box-shadow: 0 10px 30px rgba(0,0,0,0.2); object-fit: cover; }

/* =========================================
   6. CARDS & TIMELINE
   ========================================= */
